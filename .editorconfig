root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Generated code — suppress all analyzer rules
[src/Lolzteam.Api/Generated/**/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
